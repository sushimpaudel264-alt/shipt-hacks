# Copy to .env.local. All AI keys are server-only: never prefix them with NEXT_PUBLIC_.

# Google Gemini (optional). Without a key AND model, LearnLoop uses realistic mock AI.
GEMINI_API_KEY=
# Model name is configuration, not code. Use any Gemini model that supports structured JSON output.
GEMINI_MODEL=

# true = always use mock AI (demo-safe, no network calls to Gemini)
MOCK_AI=true
# Artificial mock latency in ms (makes loading states visible in demos)
MOCK_AI_DELAY_MS=700

# Optional: register the service worker in `next dev` too (it's always on in production builds)
# NEXT_PUBLIC_ENABLE_SW=true
