# LearnLoop environment variables. Copy to .env.local for local dev; set the same names in Vercel.
# Everything works with the defaults below (mock AI, no API key needed).

# Google Gemini API key (server-only; never prefix with NEXT_PUBLIC_). Leave empty to use mock AI.
GEMINI_API_KEY=

# Gemini model name, e.g. one that supports structured JSON output. Leave empty to use mock AI.
GEMINI_MODEL=

# "true" forces mock AI even when a key and model are set (demo-safe, no external calls).
MOCK_AI=true

# Artificial delay for mock AI responses, in milliseconds (makes loading states visible in demos).
MOCK_AI_DELAY_MS=700

# "true" registers the service worker during `npm run dev` too. It is always on in production builds.
NEXT_PUBLIC_ENABLE_SW=false
